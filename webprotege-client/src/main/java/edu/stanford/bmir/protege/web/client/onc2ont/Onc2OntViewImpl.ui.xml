<?xml version="1.0" encoding="UTF-8"?>
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'>
    <ui:style>
        .main {
            padding: 10px;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .notesArea {
            width: 100%;
            min-height: 200px;
            margin-bottom: 10px;
            font-family: monospace;
            padding: 5px;
            flex: 1;
        }
        .submitButton {
            margin-bottom: 10px;
            padding: 5px 15px;
        }
        .statusLabel {
            color: #666;
            margin-top: 5px;
        }
        .title {
            font-weight: bold;
            margin-bottom: 5px;
        }
        .instructions {
            margin-bottom: 10px;
            color: #666;
        }
    </ui:style>
    <g:HTMLPanel addStyleNames="{style.main}">
        <g:Label addStyleNames="{style.title}">Clinical Notes to Ontology Converter</g:Label>
        <g:Label addStyleNames="{style.instructions}">Enter clinical notes below and click "Convert" to generate an ontology from the text.</g:Label>
        <g:TextArea ui:field="notesArea" addStyleNames="{style.notesArea}"></g:TextArea>
        <g:Button ui:field="submitButton" text="Convert" addStyleNames="{style.submitButton}"></g:Button>
        <g:Label ui:field="statusLabel" addStyleNames="{style.statusLabel}"></g:Label>
    </g:HTMLPanel>
</ui:UiBinder>
